# ===== Telegram（必須） =====
# @BotFather で作成したボットのトークン
TELEGRAM_BOT_TOKEN=
# 通知先の chat_id（個人 / グループ / チャンネル）。カンマ区切りで複数可。
# 取得方法: ボットに何か話しかけて https://api.telegram.org/bot<TOKEN>/getUpdates を開く
TELEGRAM_CHAT_ID=

# ===== 対象チェーン =====
# DexScreener 上の chainId。Robinhood Chain は "robinhood"
CHAIN_ID=robinhood

# ===== 監視ペアの発見（DexScreener） =====
# /latest/dex/search に投げるクエリ（各クエリ最大 30 件、chainId でフィルタ）
DISCOVERY_SEARCH_QUERIES=robinhood,WETH,HOOD,ETH,USDC,USDT,pump,cat,dog,pepe,ai
# このトークンを含む全プールを取得して監視対象に追加（WETH など主要 quote トークン）
DISCOVERY_TOKEN_ADDRESSES=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# token-profiles / token-boosts（DexScreener で宣伝・ブースト中のトークン）も取り込む
DISCOVERY_USE_PROFILES=true
DISCOVERY_INTERVAL_SEC=120

# ===== 監視ペアの発見（チェーン RPC / 任意だが推奨） =====
# Uniswap V2/V3/V4 系ファクトリの PairCreated / PoolCreated / Initialize イベントを直接監視して
# 新規プールを即座に検知します。空にすると無効。
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_SCAN_INTERVAL_SEC=20
# 1 回の eth_getLogs で読むブロック数（100ms ブロックなので 2000 ≒ 200 秒分）
RPC_BLOCK_CHUNK=2000
# 起動時に何ブロック遡ってスキャンするか（0 = 最新から）
RPC_BACKFILL_BLOCKS=36000
# ファクトリアドレスで絞りたい場合はカンマ区切りで指定（空 = トピックのみで全 DEX を監視）
RPC_FACTORY_ADDRESSES=

# ===== 価格・出来高の更新間隔 =====
# hot（直近に出来高あり / 新規）ペアの更新間隔
POLL_INTERVAL_SEC=45
# dormant（低迷中）ペアの更新間隔 ※復活検知はここが効く
DORMANT_POLL_INTERVAL_SEC=240
# dead（流動性ほぼゼロ）ペアの更新間隔
DEAD_POLL_INTERVAL_SEC=1800
# 流動性がこの額未満なら dead 扱い
DEAD_LIQUIDITY_USD=300
# dead が続いたら監視対象から外す日数
DEAD_DROP_DAYS=7
# 1h 出来高がこの額以上なら hot
HOT_VOL_H1_USD=1000

# ===== 共通フィルタ =====
MIN_LIQUIDITY_USD=5000
# 検知対象の quote トークン（空 = 制限なし）。例: WETH,USDC
QUOTE_SYMBOLS=

# ===== ① 新規ローンチ検知 =====
NEW_LAUNCH_ENABLED=true
# ペア作成からこの時間以内を「新規」とみなす
# これを過ぎたものは復活検知側が担当する
NEW_MAX_AGE_HOURS=12
# 1h 出来高がこの額を超えたら通知。カンマ区切りで段階通知（各段階を超えるたびに 1 回）
NEW_VOL_H1_TIERS_USD=25000,100000,500000
# 直近 1h の買い件数の最低値（wick / 単発取引の除外）
NEW_MIN_BUYS_H1=15
# 時価総額の下限。これ未満の新規ローンチは通知しない。
# 開発の重心は再点火（♻️🔥）に置いているので、新規は規模のあるものだけに絞る。
# 時価総額が取れない銘柄は規模を判断できないため通さない。
NEW_MIN_MC_USD=1000000

# --- 低MC レーン（試験運用中） ---
# 上の下限を下回っていても、その規模に見合う出来高と参加者の厚みがあるなら通す。
# $150K〜$200K でコールされて $2M まで伸びる銘柄を、下限だけで捨てないため。
#
# 出来高比が高いことは「作られた出来高」の特徴でもあるので、
# 厚み（多数の小口が売り買いしている）を必須にして切り分ける。
# 成績は日次レポートに「🌱 新規(低MC)」として通常の新規と分けて出るので、
# しばらく回して的中率を見てから、下の値を詰めるか OFF にするか決めてください。
NEW_LOW_MC_ENABLED=true
# このレーンで拾う時価総額の下限。
# 実物の $QC は MC $175.8K でコールされ $2M まで伸びたので、$200K では取り逃がした。
# 実際の絞り込みは下の 3 条件（出来高比・流動性・厚み）が担っているので、ここは下支え。
NEW_LOW_MC_FLOOR_USD=150000
# 1h 出来高が時価総額の何倍以上あれば「出来高が伴っている」とみなすか。
# 実物の $QC は 3.72 倍だったので、その水準に合わせて 3.0（余裕を持たせた値）。
# 上げる = 厳しくなる（本当に回っているものだけ） / 下げる = 通知が増える
#
# この値は日次レポートの「出来高/MC」欄で的中率が倍率別に出るので、
# 数日分たまったら勘ではなく数字で詰めてください。
NEW_LOW_MC_VOL_TO_MC=3.0
# このレーン専用の流動性の下限。
# 全体の MIN_LIQUIDITY_USD は時価総額 $1M 以上を前提にした値で、小型には緩すぎる。
# 薄いプールでは出来高があっても実際には出られない
NEW_LOW_MC_MIN_LIQUIDITY_USD=25000

# ===== ② 復活スパイク検知（最重要） =====
REVIVAL_ENABLED=true
# ペア作成からこの時間以上経過したものが対象。
# 「直前が静かだった」ことは出来高の突発率で判定するので、年齢は最低限でよい
REVIVAL_MIN_AGE_HOURS=6
# 価格上昇率のしきい値（%）。DexScreener の 1h 変化率 or 自前スナップショットの lookback 変化率
REVIVAL_PRICE_CHANGE_PCT=30
# 自前スナップショットで何分前の安値と比較するか
REVIVAL_LOOKBACK_MIN=120
# 1h 出来高の最低値
# $PARLEY（MC $50K）は出来高 $10.7K/h の時点で拾って 15 倍になった。旧下限 $10K だと 7% しか余裕が無かった。
# 静穏からの立ち上がりは出来高が小さいのが前提。日次レポートの「出来高: 低」の的中率で妥当性を見る
REVIVAL_MIN_VOL_H1_USD=5000
# 1h 出来高 ÷ 直前 23h の平均 1h 出来高 がこの倍率以上なら「突発」
REVIVAL_VOL_SPIKE_RATIO=3
# 直近 1h の買い件数の最低値
REVIVAL_MIN_BUYS_H1=10
# --- 再点火の検知（最重視するパターン）---
# 初動で大きな時価総額をつけた銘柄が、冷え込んでレンジを組み、そこを抜ける動き。
# 例: MC $5M をつけたあと下落し、$1.0〜1.5M でヨコヨコ → そのレンジを上抜けた瞬間。
# 過去に大きな評価を得た履歴が確度を担保するので、しきい値を下げて早く拾える。
REIGNITE_ENABLED=true
# 全盛期の時価総額がこの額以上だった銘柄だけを対象にする。
# $MOO（レンジ $150〜200K、全盛期 $600K 前後）が $800K の門で監視から漏れ、急変レーンで拾うことになった。
# このチェーンの本物は $QC $175K・$PARLEY $50K と小さいところで動くので、門は低めに置く
REIGNITE_MIN_PEAK_MC_USD=300000
# いまの時価総額が全盛期のこの割合以下なら「冷えた」とみなす。
# 下落幅は銘柄ごとにまちまちなので、ここは緩い安全網に留める。
# 「上げ続けていない」ことは、下のレンジ成立条件が実質的に担保する。
REIGNITE_COOLED_RATIO=0.8
# 時価総額のレンジ上限をこの % 抜けたら通知。汎用のレンジ抜け(12%)より低くてよい
REIGNITE_BREAKOUT_PCT=6

# --- レンジの成立条件 ---
# 「窓内の最高値」を天井とすると、下落途中の一点を誤って天井扱いしてしまう。
# 値が一定の幅に収まったまま時間が経っている状態を、レンジとして確かめる。
# 判定は倍率と時間だけなので、時価総額が $2M でも $50M でも同じ基準で効く。
# 何時間ぶんを見るか（スナップショット保持期間 SNAPSHOT_RETENTION_HOURS 以内にすること）。
# この長さから下限まで窓を段階的に縮めて試し、最初に成立したもの＝最も長いレンジを採る。
# 初動スパイクを含む窓は幅の条件で落ちるので、落ち着いた区間だけが残る
RANGE_WINDOW_HOURS=48
# レンジと認めるのに必要な最低観測期間。$MOO は 7〜8 時間の横ばいから抜けたので 12 では届かない
RANGE_MIN_HOURS=6
# 帯の幅（上限÷下限-1）がこの % を超えたらトレンド中とみなし、レンジとしない。
# ミームコインのレンジは実際かなり広い（$280K〜$620K で 121% など）ので緩めに取る
RANGE_MAX_WIDTH_PCT=150
# レンジと認めるのに必要な最低観測点数
RANGE_MIN_SAMPLES=20
# いまの時価総額がこれ未満の銘柄はヨコヨコ監視から外す。
# 全盛期の門は「過去に大きかったか」しか見ないので、$8K まで死んだ銘柄の平坦な線も帯に見えてしまう。
# 再点火の検知も同じ下限を読む（一覧と通知がずれないように）。動きがあれば急変レーンが拾う
RANGE_MIN_MC_USD=30000

# --- 優先監視 ---
# 全盛期の時価総額がこの額を超えた銘柄は、いま静かでも短い間隔で見張る。
# 再点火はこういう銘柄から起きるので、dormant の 4 分間隔では遅い。
PRIORITY_PEAK_MC_USD=300000
PRIORITY_POLL_INTERVAL_SEC=45

# --- レンジ上抜けの検知（出来高が元から多い銘柄の急騰を拾う経路）---
# ヨコヨコのレンジ上限をこの % 超えたら通知。下げるほど早く気づけるが、だましも増える
REVIVAL_BREAKOUT_PCT=12
# レンジ上限を測る窓（分）。この範囲の高値をレンジ上限とみなす
REVIVAL_BASE_WINDOW_MIN=1440
# 直近の値動きそのものはレンジ計算から除く（分）。除かないと自分自身を超えられない
REVIVAL_RANGE_EXCLUDE_MIN=30
# 5 分足でこの % 以上動いたら、1h 変化率を待たずに通知（0 で無効）
REVIVAL_FAST_M5_PCT=20

# 同一トークンの再通知までの最短時間（分）
REVIVAL_COOLDOWN_MIN=180
# クールダウン中でも前回通知時の価格からこの % 以上さらに上がったら再通知（0 = 無効）
REVIVAL_ESCALATION_PCT=50

# ===== ③ スキャム除外フィルタ =====
# バンドル・洗浄取引で出来高を作られた銘柄を通知しない。
# 検知自体は続き、止めたものは /filtered で確認できる。
SCAM_FILTER_ENABLED=true
# リスクスコアがこの値以上なら通知しない（0-100）
# 上げる = 通しやすくなる / 下げる = 厳しくなる
SCAM_SCORE_THRESHOLD=50
# 1h 出来高 ÷ 流動性。この倍率で加点（実需では数倍を超えにくい）
SCAM_CHURN_MID=4
SCAM_CHURN_HIGH=8
# 流動性 ÷ 時価総額 がこの % 未満なら加点（売り抜けられない薄さ）。段階あり:
#   MIN_DEPTH 未満 → +25 / SEVERE 未満 → +40 / DEAD 未満 → +55（単独でしきい値超え）
# $CUPCAKE（流動性 $864 に時価総額 $59.6M = 0.0014%）が 1.9% と同じ +25 で通ってしまった反省
SCAM_MIN_DEPTH_PCT=2
SCAM_DEPTH_SEVERE_PCT=1
SCAM_DEPTH_DEAD_PCT=0.2
# この流動性未満で、この上昇率を超えていたら加点（少額で値を動かせる状態）
SCAM_PUMP_PCT=1000
SCAM_PUMP_LIQUIDITY_USD=150000
# 流動性の絶対値がこれ未満なら加点
SCAM_MIN_LIQUIDITY_USD=20000
# 平均取引額がこれ未満なら加点（件数稼ぎの塵取引）
SCAM_MIN_AVG_TRADE_USD=40
# 通知する場合でも、スコアがこれ以上なら本文に注意点を載せる
SCAM_SHOW_SCORE_FROM=20

# --- 参加者の厚み（本物の初動ランナーを誤って弾かないための救済） ---
# 出来高の倍率だけでは本物とバンドルを分けられない。
# 実際 $SNOWBALL（本物）は流動性の 18.1 倍、$PUMPS（バンドル）は 9.1 倍で、本物のほうが高かった。
# 分かれたのは「小口が大量に流れているか」。
# 下の条件を満たした銘柄では、出来高比による減点（churn / turnover / instant_volume）を行わない。
# 1h の取引件数がこれ以上（必須条件）
SCAM_BREADTH_MIN_TXNS=2000
# 平均取引額がこの額以下（かつ SCAM_MIN_AVG_TRADE_USD 以上）なら小口中心とみなす（必須条件）
SCAM_BREADTH_MAX_AVG_USD=500
# 買いの比率がこの値〜(1-この値) の範囲なら売り買い拮抗とみなす（加点条件）
SCAM_BREADTH_BALANCE=0.4
# 上の 3 条件のうち何個を満たせば厚みと認めるか（2 = 必須 2 条件のみ / 3 = 拮抗も必須）
# 通したい銘柄が止まっているなら 2 のまま MIN_TXNS を下げる、通しすぎなら 3 にする
SCAM_BREADTH_NEEDED=2
# 件数の下限は規模で変える。この時価総額未満は小型として扱い、下の件数を使う
# （$200K の銘柄に $1M クラスの件数を求めると、実需があっても届かないため）
SCAM_BREADTH_SMALL_MC_USD=1000000
SCAM_BREADTH_SMALL_MIN_TXNS=300

# --- 出来高が何時間もほぼ一定（機械的な回し） ---
# 本物の市場は出来高が波打つ。ボットが一定の玉を回して価格を固定していると、
# 1 時間ごとの出来高が判で押したように揃う。/ranges に並んでいたバンドルの多くがこれ。
# 1h 出来高を 1 時間ごとに平均し、その変動係数（標準偏差÷平均）がこれ以下なら疑う。
# 出来高が流動性の半分以上なら +30、流動性以上（毎時プールが入れ替わる）なら +50＝単独で止まる
SCAM_STEADY_CV=0.2
SCAM_STEADY_MIN_HOURS=6
SCAM_STEADY_MIN_CHURN=0.5

# ===== 通知メッセージの見せ方 =====
# 復活通知の「出来高 低/中/高」の境目
VOL_LEVEL_MID_USD=50000
VOL_LEVEL_HIGH_USD=250000
# 買いか売りがこの比率を超えて偏ったときだけ、売買件数を表示する
TXN_SKEW_SHOW=0.65

# ===== ④ 反省: 結果追跡と日次レポート =====
# 通知したもの・止めたものの「その後」をスナップショットから自動で追い、
# 毎朝、種別ごとの成績・良かった/悪かったコール・止めたが伸びた銘柄・改善案を送る。
# 的中の定義: この時間以内に この % 以上 上がる
OUTCOME_HIT_PCT=30
# 結果判定で「売れる価格」として数える流動性の下限。
# プールが枯れると DexScreener は最後の約定価格を返し続けるので、これが無いと
# 「+39741% で 4 時間保った」ような、実際には誰も売れなかった利益が成績に混ざる。
# 損失側（流動性が抜かれた＝ラグ）はそのまま数える
OUTCOME_MIN_LIQUIDITY_USD=5000
OUTCOME_HIT_WINDOW_HOURS=4
# この % 以上 下がったら「失敗」
OUTCOME_BUST_PCT=50
REPORT_ENABLED=true
# レポートを送る時刻（JST・時）
REPORT_HOUR_JST=9
# 属性ごとの差を「傾向」として挙げるのに必要な最低件数
REPORT_MIN_SAMPLES=4

# ===== ⑤ スマートウォレット（RPC が必要） =====
# 勝ちと確定した復活銘柄について、急騰の前（底・レンジ）に買っていたウォレットを集める。
# 複数の勝ち銘柄に早期から入っているウォレットを ⭐ として台帳に育てる（/smart）。
SMART_WALLET_ENABLED=true
# ⭐ にするのに必要な勝ち銘柄数
SMART_MIN_HITS=2
# 通知の何時間前までを「急騰前」として集めるか
SMART_HARVEST_WINDOW_HOURS=6
# 窓内の Swap がこれを超える銘柄は収穫しない（バンドル・洗浄取引の疑い）
SMART_MAX_SWAPS=3000
# ブロック時間の目安（ms）。時刻→ブロックの当たりをつけるのに使う。ずれていても二分探索で補正される
RPC_BLOCK_TIME_MS=250

# ===== その他 =====
DB_PATH=./data/bot.sqlite
SNAPSHOT_RETENTION_HOURS=96
LOG_LEVEL=info
# 起動時に Telegram へ起動メッセージを送る
NOTIFY_ON_START=true
